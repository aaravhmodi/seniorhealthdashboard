# ---- Sprint 0: everything below is optional. The mock runs with none of it. ----
APP_ENV=dev
MOCK_MODE=true            # true = canned LLM/evidence/Linq. Flip to false in Sprint 1+.

# Sprint 1
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Linq (caregiver messaging). Sandbox creds from the Linq booth.
LINQ_API_KEY=
# Base URL for the iMessage/RCS/SMS channel. Linq runs three separate partner
# APIs (iMessage here, Apple Messages for Business at messages.api.linqapp.com,
# WhatsApp at whatsapp.messages.api.linqapp.com) and a key is valid for exactly
# one of them.
LINQ_API_BASE=https://api.linqapp.com/api/partner
LINQ_WEBHOOK_SECRET=devsecret

# Sprint 2 (data track)
DUCKDB_PATH=./data/warehouse.duckdb

# Supabase, for state that outlives a restart. Unset = in-memory only, which
# is how this ran before and how the tests run. Run backend/sql/001_*.sql once
# in the SQL editor, then add "carepath" under Settings > API > Exposed schemas.
# SERVICE_ROLE bypasses RLS: backend only, never the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signs the caregiver link in every family text. Unset means no detail link is
# sent at all, rather than a guessable one. Any long random string.
CAREGIVER_LINK_SECRET=
LINK_TTL_DAYS=7

# Lock the patient-data endpoints. Unset = open, and the server says so loudly
# on every boot. SUPABASE_JWT_SECRET is Settings > API > JWT Settings.
SUPABASE_JWT_SECRET=
API_SHARED_SECRET=
