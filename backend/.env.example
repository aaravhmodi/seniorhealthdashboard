# ---- Sprint 0: everything below is optional. The mock runs with none of it. ----
APP_ENV=dev
MOCK_MODE=true            # true = canned LLM/evidence/Linq. Flip to false in Sprint 1+.

# Sprint 1
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Linq (caregiver messaging). Sandbox creds from the Linq booth.
LINQ_API_KEY=
# Base URL for the iMessage/RCS/SMS channel. Linq runs three separate partner
# APIs (iMessage here, Apple Messages for Business at messages.api.linqapp.com,
# WhatsApp at whatsapp.messages.api.linqapp.com) and a key is valid for exactly
# one of them.
LINQ_API_BASE=https://api.linqapp.com/api/partner
LINQ_WEBHOOK_SECRET=devsecret

# Sprint 2 (data track)
DUCKDB_PATH=./data/warehouse.duckdb
