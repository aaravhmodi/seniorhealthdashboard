# ---- Sprint 0: everything below is optional. The mock runs with none of it. ----
APP_ENV=dev
MOCK_MODE=true            # true = canned LLM/evidence/Linq. Flip to false in Sprint 1+.

# Sprint 1
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Linq (caregiver messaging). Sandbox creds from the Linq booth.
LINQ_API_KEY=
LINQ_API_BASE=https://api.linq.app
LINQ_WEBHOOK_SECRET=devsecret

# Sprint 2 (data track)
DUCKDB_PATH=./data/warehouse.duckdb
